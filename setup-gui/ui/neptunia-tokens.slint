// GENERADO por packages/neptunia-slint.nix desde share/themes/neptunia.nix.
// No lo edites a mano: regenéralo con `nix build .#neptunia-slint`.
//
// theme: "light" | "dark" | "dark-tint"; el resto son los tokens del
// sistema Neptunia (docs/first-boot/neptunia-tokens.css).
export struct Accent {
    id: string,
    color: color,
    label: string,
}

export global Tokens {
    in-out property <string> theme: "light";
    out property <bool> dark: theme != "light";

    out property <color> bgWindow: theme == "light" ? #f2f4f7 : (theme == "dark" ? #1e1e1e : #1d1e20);
    out property <color> bgSunken: theme == "light" ? #e7ebf1 : (theme == "dark" ? #161616 : #151617);
    out property <color> bgSurface: theme == "light" ? #ffffff : (theme == "dark" ? #262626 : #252628);
    out property <color> bgRaised: theme == "light" ? #ffffff : (theme == "dark" ? #2b2b2b : #2a2b2e);
    out property <color> bgControl: theme == "light" ? #e3e8ef : (theme == "dark" ? #3a3a3a : #38393d);
    out property <color> bgHover: theme == "light" ? #dde3eb : (theme == "dark" ? #444444 : #424448);
    out property <color> line: theme == "light" ? #d6dce5 : (theme == "dark" ? #333333 : #323336);
    out property <color> lineStrong: theme == "light" ? #848fa1 : (theme == "dark" ? #747474 : #73767c);
    out property <color> ink: theme == "light" ? #1b2330 : (theme == "dark" ? #dcdcdc : #dadcdf);
    out property <color> inkStrong: theme == "light" ? #0d1219 : (theme == "dark" ? #f5f5f5 : #f4f5f6);
    out property <color> inkMuted: theme == "light" ? #55657e : (theme == "dark" ? #9b9b9b : #999ca3);
    out property <color> inkFaint: theme == "light" ? #8a96a8 : (theme == "dark" ? #6b6b6b : #696b70);
    out property <color> accent: theme == "light" ? #4a64a8 : (theme == "dark" ? #4a64a8 : #4a64a8);
    out property <color> accentStrong: theme == "light" ? #3b5496 : (theme == "dark" ? #97b7ff : #97b7ff);
    out property <color> onAccent: theme == "light" ? #ffffff : (theme == "dark" ? #ffffff : #ffffff);
    out property <color> accentSoft: theme == "light" ? #dce4f5 : (theme == "dark" ? #2c3550 : #2b3550);
    out property <color> danger: theme == "light" ? #b04a46 : (theme == "dark" ? #e5807c : #e5807c);
    out property <color> dangerFill: theme == "light" ? #b04a46 : (theme == "dark" ? #b04a46 : #b04a46);
    out property <color> onDanger: theme == "light" ? #ffffff : (theme == "dark" ? #ffffff : #ffffff);
    out property <color> success: theme == "light" ? #357a42 : (theme == "dark" ? #8ecb94 : #8ecb94);
    out property <color> warning: theme == "light" ? #86661a : (theme == "dark" ? #cfb984 : #cfb984);
    out property <color> info: theme == "light" ? #7058a0 : (theme == "dark" ? #aa96c2 : #aa96c2);
    out property <color> cyan: theme == "light" ? #3a6f87 : (theme == "dark" ? #a5c0d2 : #a5c0d2);
    out property <color> windowOuter: theme == "light" ? rgba(13, 18, 25, 0.12) : (theme == "dark" ? rgba(0, 0, 0, 0.9) : rgba(0, 0, 0, 0.9));
    out property <color> windowInner: theme == "light" ? rgba(255, 255, 255, 0) : (theme == "dark" ? rgba(255, 255, 255, 0.14) : rgba(255, 255, 255, 0.14));
    out property <color> scrim: theme == "light" ? rgba(13, 18, 25, 0.28) : (theme == "dark" ? rgba(0, 0, 0, 0.5) : rgba(0, 0, 0, 0.5));
    out property <length> space1: 4px;
    out property <length> space2: 8px;
    out property <length> space3: 12px;
    out property <length> space4: 16px;
    out property <length> space6: 24px;
    out property <length> space8: 32px;
    out property <length> radiusxs: 4px;
    out property <length> radiussm: 7px;
    out property <length> radiusButton: 8px;
    out property <length> radiusmd: 10px;
    out property <length> radiuslg: 14px;
    out property <length> radiusxl: 20px;
    out property <length> radiuspill: 999px;
    out property <length> controlsm: 24px;
    out property <length> controlmd: 30px;
    out property <length> controllg: 38px;
    out property <duration> durFast: 120ms;
    out property <duration> durBase: 220ms;
    out property <duration> durSlow: 420ms;

    out property <[Accent]> gnomeAccents: [
        { id: "blue", color: #3584e4, label: "Azul" },
        { id: "teal", color: #2190a4, label: "Verde azulado" },
        { id: "green", color: #3a944a, label: "Verde" },
        { id: "yellow", color: #c88800, label: "Amarillo" },
        { id: "orange", color: #ed5b00, label: "Naranja" },
        { id: "red", color: #e62d42, label: "Rojo" },
        { id: "pink", color: #d56199, label: "Rosa" },
        { id: "purple", color: #9141ac, label: "Morado" },
        { id: "slate", color: #6f8396, label: "Pizarra" },
    ];
}
