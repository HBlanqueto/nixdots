// Generado desde share/design/neptunia (tokens.json, components.json). No editar a mano:
// cambia los JSON y regenera con `nix eval --raw -f share/design/neptunia slint`.
export enum NeptuniaMode { light, dark, dark-tint }

export global Theme {
    in-out property <NeptuniaMode> mode: NeptuniaMode.light;

    // Colores (por tema)
    out property <color> accent: mode == NeptuniaMode.dark ? #2f6fe4 : mode == NeptuniaMode.dark-tint ? #2f6fe4 : #2f6fe4;
    out property <color> accent-hover: mode == NeptuniaMode.dark ? #2560cf : mode == NeptuniaMode.dark-tint ? #2560cf : #2560cf;
    out property <color> accent-soft: mode == NeptuniaMode.dark ? #1f3358 : mode == NeptuniaMode.dark-tint ? #1f3358 : #dbe7fd;
    out property <color> accent-strong: mode == NeptuniaMode.dark ? #6aa2ff : mode == NeptuniaMode.dark-tint ? #6aa2ff : #1f53bd;
    out property <color> bg-control: mode == NeptuniaMode.dark ? #3a3a3a : mode == NeptuniaMode.dark-tint ? #38393d : #e3e8ef;
    out property <color> bg-hover: mode == NeptuniaMode.dark ? #444444 : mode == NeptuniaMode.dark-tint ? #424448 : #dde3eb;
    out property <color> bg-raised: mode == NeptuniaMode.dark ? #2b2b2b : mode == NeptuniaMode.dark-tint ? #2a2b2e : #ffffff;
    out property <color> bg-sunken: mode == NeptuniaMode.dark ? #161616 : mode == NeptuniaMode.dark-tint ? #151617 : #e7ebf1;
    out property <color> bg-surface: mode == NeptuniaMode.dark ? #262626 : mode == NeptuniaMode.dark-tint ? #252628 : #ffffff;
    out property <color> bg-window: mode == NeptuniaMode.dark ? #1e1e1e : mode == NeptuniaMode.dark-tint ? #1d1e20 : #f2f4f7;
    out property <color> cyan: mode == NeptuniaMode.dark ? #4fb6e3 : mode == NeptuniaMode.dark-tint ? #4fb6e3 : #0a6f9a;
    out property <color> danger: mode == NeptuniaMode.dark ? #ff6b6b : mode == NeptuniaMode.dark-tint ? #ff6b6b : #cc2f35;
    out property <color> danger-fill: mode == NeptuniaMode.dark ? #d6363b : mode == NeptuniaMode.dark-tint ? #d6363b : #d6363b;
    out property <color> info: mode == NeptuniaMode.dark ? #b18cff : mode == NeptuniaMode.dark-tint ? #b18cff : #7a49c9;
    out property <color> ink: mode == NeptuniaMode.dark ? #dcdcdc : mode == NeptuniaMode.dark-tint ? #dadcdf : #1b2330;
    out property <color> ink-faint: mode == NeptuniaMode.dark ? #6b6b6b : mode == NeptuniaMode.dark-tint ? #696b70 : #8a96a8;
    out property <color> ink-muted: mode == NeptuniaMode.dark ? #9b9b9b : mode == NeptuniaMode.dark-tint ? #999ca3 : #55657e;
    out property <color> ink-strong: mode == NeptuniaMode.dark ? #f5f5f5 : mode == NeptuniaMode.dark-tint ? #f4f5f6 : #0d1219;
    out property <color> line: mode == NeptuniaMode.dark ? #333333 : mode == NeptuniaMode.dark-tint ? #323336 : #d6dce5;
    out property <color> line-strong: mode == NeptuniaMode.dark ? #747474 : mode == NeptuniaMode.dark-tint ? #73767c : #848fa1;
    out property <color> on-accent: mode == NeptuniaMode.dark ? #ffffff : mode == NeptuniaMode.dark-tint ? #ffffff : #ffffff;
    out property <color> on-danger: mode == NeptuniaMode.dark ? #ffffff : mode == NeptuniaMode.dark-tint ? #ffffff : #ffffff;
    out property <color> scrim: mode == NeptuniaMode.dark ? #00000080 : mode == NeptuniaMode.dark-tint ? #00000080 : #0d121947;
    out property <color> success: mode == NeptuniaMode.dark ? #5fcf7c : mode == NeptuniaMode.dark-tint ? #5fcf7c : #1a7f37;
    out property <color> sys-blue: mode == NeptuniaMode.dark ? #2f6fe4 : mode == NeptuniaMode.dark-tint ? #2f6fe4 : #2f6fe4;
    out property <color> sys-cyan: mode == NeptuniaMode.dark ? #0f86b8 : mode == NeptuniaMode.dark-tint ? #0f86b8 : #0f86b8;
    out property <color> sys-gray: mode == NeptuniaMode.dark ? #7d828c : mode == NeptuniaMode.dark-tint ? #7d828c : #7d828c;
    out property <color> sys-green: mode == NeptuniaMode.dark ? #28a046 : mode == NeptuniaMode.dark-tint ? #28a046 : #28a046;
    out property <color> sys-orange: mode == NeptuniaMode.dark ? #e8780e : mode == NeptuniaMode.dark-tint ? #e8780e : #e8780e;
    out property <color> sys-purple: mode == NeptuniaMode.dark ? #8e5bd8 : mode == NeptuniaMode.dark-tint ? #8e5bd8 : #8e5bd8;
    out property <color> sys-red: mode == NeptuniaMode.dark ? #d6363b : mode == NeptuniaMode.dark-tint ? #d6363b : #d6363b;
    out property <color> traffic-close: mode == NeptuniaMode.dark ? #e0625d : mode == NeptuniaMode.dark-tint ? #e0625d : #e0625d;
    out property <color> traffic-min: mode == NeptuniaMode.dark ? #d9a63a : mode == NeptuniaMode.dark-tint ? #d9a63a : #d9a63a;
    out property <color> traffic-zoom: mode == NeptuniaMode.dark ? #4fae5f : mode == NeptuniaMode.dark-tint ? #4fae5f : #4fae5f;
    out property <color> warning: mode == NeptuniaMode.dark ? #f0a43a : mode == NeptuniaMode.dark-tint ? #f0a43a : #a15c00;
    out property <color> window-inner: mode == NeptuniaMode.dark ? #ffffff24 : mode == NeptuniaMode.dark-tint ? #ffffff24 : #ffffff00;
    out property <color> window-outer: mode == NeptuniaMode.dark ? #000000e6 : mode == NeptuniaMode.dark-tint ? #000000e6 : #0d12191f;

    // Redondeo, espacio, tamaños y duraciones
    out property <length> radius-button: 8px;
    out property <length> radius-lg: 16px;
    out property <length> radius-md: 12px;
    out property <length> radius-pill: 999px;
    out property <length> radius-sm: 8px;
    out property <length> radius-xl: 16px;
    out property <length> radius-xs: 4px;
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-6: 24px;
    out property <length> space-8: 32px;
    out property <length> control-lg: 38px;
    out property <length> control-md: 30px;
    out property <length> control-sm: 24px;
    out property <length> sidebar-w: 220px;
    out property <length> titlebar-h: 44px;
    out property <duration> dur-base: 220ms;
    out property <duration> dur-fast: 120ms;
    out property <duration> dur-slow: 420ms;

    // Tipografía
    out property <string> font-sans: "Inter";
    out property <string> font-mono: "SF Mono Ligaturized";
    out property <string> font-script: "Dancing Script";
    out property <length> text-body-size: 13px;
    out property <length> text-callout-size: 12px;
    out property <length> text-caption-size: 11px;
    out property <length> text-display-size: 28px;
    out property <length> text-greeting-size: 150px;
    out property <length> text-headline-size: 13px;
    out property <length> text-mono-size: 12px;
    out property <length> text-title-1-size: 20px;
    out property <length> text-title-2-size: 15px;
    out property <int> text-body-weight: 400;
    out property <int> text-callout-weight: 400;
    out property <int> text-caption-weight: 500;
    out property <int> text-display-weight: 700;
    out property <int> text-greeting-weight: 600;
    out property <int> text-headline-weight: 600;
    out property <int> text-mono-weight: 400;
    out property <int> text-title-1-weight: 650;
    out property <int> text-title-2-weight: 600;

    // Sombras (Slint admite una por elemento)
    out property <length> shadow-window-offset-y: 18px;
    out property <length> shadow-window-blur: 48px;
    out property <color> shadow-window-color: mode == NeptuniaMode.light ? #0d12192e : #0000008c;
    out property <length> shadow-float-offset-y: 10px;
    out property <length> shadow-float-blur: 28px;
    out property <color> shadow-float-color: mode == NeptuniaMode.light ? #0d121929 : #00000080;
    out property <length> shadow-knob-offset-y: 1px;
    out property <length> shadow-knob-blur: 3px;
    out property <color> shadow-knob-color: #0d12194d;
}

// Medidas de components.json (switch-width, segmented-segment-radius, toolbar-tabs-tab-min-width…)
export global Metrics {
    out property <length> badge-height: 20px;
    out property <length> badge-padding-x: 8px;
    out property <length> badge-radius: 999px;
    out property <length> bento-tile-gap: 12px;
    out property <int> bento-tile-grid-columns: 4;
    out property <length> bento-tile-padding: 16px;
    out property <length> bento-tile-radius: 16px;
    out property <length> bento-tile-row-height: 92px;
    out property <length> button-font-size: 13px;
    out property <int> button-font-weight: 500;
    out property <int> button-font-lg-weight: 600;
    out property <length> button-height: 30px;
    out property <length> button-height-lg: 38px;
    out property <length> button-height-sm: 24px;
    out property <length> button-icon: 16px;
    out property <length> button-icon-gap: 4px;
    out property <length> button-min-width-lg: 112px;
    out property <length> button-padding-x: 16px;
    out property <length> button-padding-x-lg: 22px;
    out property <length> button-padding-x-sm: 12px;
    out property <float> button-pressed-scale: 0.970000;
    out property <length> button-radius: 8px;
    out property <length> checkbox-check-stroke: 2.200000px;
    out property <length> checkbox-radius: 4px;
    out property <length> checkbox-size: 16px;
    out property <length> dialog-padding: 20px;
    out property <length> dialog-radius: 16px;
    out property <length> focus-ring-offset: 2px;
    out property <length> focus-ring-width: 2px;
    out property <length> icon-button-icon: 16px;
    out property <length> icon-button-radius: 8px;
    out property <length> icon-button-round-variant-radius: 999px;
    out property <length> icon-button-size: 30px;
    out property <length> list-group-radius: 16px;
    out property <length> list-group-row-icon-radius: 8px;
    out property <length> list-group-row-icon-size: 22px;
    out property <length> list-group-row-min-height: 44px;
    out property <length> list-group-row-padding-x: 14px;
    out property <length> list-group-separator-inset-left: 14px;
    out property <length> menu-popover-item-height: 26px;
    out property <length> menu-popover-item-radius: 8px;
    out property <length> menu-popover-radius: 12px;
    out property <length> progress-height: 6px;
    out property <length> progress-radius: 999px;
    out property <length> progress-ring-size: 28px;
    out property <length> progress-ring-stroke: 3.500000px;
    out property <length> radio-dot: 6px;
    out property <length> radio-size: 16px;
    out property <length> segmented-font-size: 12px;
    out property <int> segmented-font-weight: 500;
    out property <length> segmented-gap: 2px;
    out property <length> segmented-padding: 2px;
    out property <length> segmented-radius: 8px;
    out property <length> segmented-segment-height: 26px;
    out property <length> segmented-segment-padding-x: 12px;
    out property <length> segmented-segment-radius: 6px;
    out property <length> slider-fat-fill-min: 22px;
    out property <length> slider-fat-height: 22px;
    out property <length> slider-fat-lead-icon-x: 8px;
    out property <length> slider-height: 20px;
    out property <length> slider-knob: 20px;
    out property <length> slider-track: 4px;
    out property <float> switch-disabled-opacity: 0.400000;
    out property <length> switch-height: 18px;
    out property <length> switch-inset: 2px;
    out property <length> switch-knob: 14px;
    out property <length> switch-small-height: 15px;
    out property <length> switch-small-inset: 2px;
    out property <length> switch-small-knob: 11px;
    out property <length> switch-small-travel: 11px;
    out property <length> switch-small-width: 26px;
    out property <duration> switch-transition: 120ms;
    out property <length> switch-travel: 14px;
    out property <length> switch-width: 32px;
    out property <length> text-field-focus-ring-width: 3px;
    out property <length> text-field-height: 30px;
    out property <length> text-field-padding-x: 12px;
    out property <length> text-field-radius: 8px;
    out property <length> text-field-search-radius: 999px;
    out property <length> toolbar-tabs-container-gap: 4px;
    out property <length> toolbar-tabs-container-padding: 6px;
    out property <length> toolbar-tabs-container-radius: 12px;
    out property <length> toolbar-tabs-tab-font-size: 11px;
    out property <int> toolbar-tabs-tab-font-weight: 500;
    out property <length> toolbar-tabs-tab-gap: 4px;
    out property <length> toolbar-tabs-tab-icon: 20px;
    out property <length> toolbar-tabs-tab-min-width: 76px;
    out property <length> toolbar-tabs-tab-padding-bottom: 5px;
    out property <length> toolbar-tabs-tab-padding-top: 6px;
    out property <length> toolbar-tabs-tab-radius: 8px;
    out property <length> window-radius: 16px;
    out property <length> window-sidebar-width: 220px;
    out property <length> window-titlebar-height: 44px;
    out property <length> window-traffic-lights-gap: 8px;
    out property <length> window-traffic-lights-radius: 4px;
    out property <length> window-traffic-lights-size: 12px;
}
