{
  "name": "neptunia-components",
  "description": "Medidas y estados de los componentes aprobados. Cada implementación (Slint, GTK, QML, web) debe respetar estos números; los colores son nombres de tokens de tokens.json.",
  "updated": "2026-10-17",
  "components": {
    "button": {
      "height": 30, "height-lg": 38, "height-sm": 24, "padding-x": 16, "padding-x-lg": 22, "padding-x-sm": 12, "min-width-lg": 112,
      "radius": "radius.button", "font": { "size": 13, "weight": 500 }, "font-lg-weight": 600, "icon": 16, "icon-gap": 4,
      "variants": {
        "primary":   { "bg": "accent", "bg-hover": "accent-hover", "fg": "on-accent" },
        "secondary": { "bg": "bg-control", "bg-hover": "bg-hover", "fg": "ink-strong" },
        "danger":    { "bg": "danger-fill", "fg": "on-danger" },
        "plain":     { "bg": "transparent", "bg-hover": "accent-soft", "fg": "accent-strong" }
      },
      "pressed-scale": 0.97,
      "rule": "Botones de texto: rectángulo redondeado, nunca cápsula. Un solo primary por vista."
    },
    "icon-button": { "size": 30, "radius": "radius.sm", "icon": 16, "round-variant-radius": "radius.pill" },
    "switch": {
      "width": 32, "height": 18, "knob": 14, "inset": 2, "travel": 14,
      "track-off": "bg-control", "track-off-border": "line", "track-on": "accent", "knob-color": "#ffffff",
      "transition": "duration.fast", "disabled-opacity": 0.4,
      "small": { "width": 26, "height": 15, "knob": 11, "inset": 2, "travel": 11, "use": "solo menús y listas densas" }
    },
    "slider": {
      "height": 20, "track": 4, "knob": 20, "track-color": "bg-control", "fill-color": "accent",
      "geometry": "knob.x = p * (width - knob); fill.width = knob.x + knob/2. La perilla nunca sale de la pista y todo va centrado en vertical.",
      "fat": { "height": 22, "fill-min": 22, "lead-icon-x": 8, "no-knob": true }
    },
    "checkbox": { "size": 16, "radius": "radius.xs", "border": "line-strong", "on": "accent", "check-stroke": 2.2 },
    "radio": { "size": 16, "dot": 6, "border": "line-strong", "on": "accent" },
    "text-field": {
      "height": 30, "padding-x": 12, "radius": "radius.sm", "bg": "bg-surface", "border": "line",
      "focus": { "border": "accent", "ring": "accent-soft", "ring-width": 3 },
      "error": { "border": "danger", "message": "danger" },
      "search": { "radius": "radius.pill", "bg": "bg-control", "border": "none" }
    },
    "segmented": {
      "padding": 2, "gap": 2, "radius": "radius.sm", "segment-radius": 6, "segment-height": 26, "segment-padding-x": 12,
      "track": "bg-control", "active-bg": "bg-surface", "active-shadow": "shadow.knob", "fg": "ink-muted", "active-fg": "ink-strong",
      "font": { "size": 12, "weight": 500 }, "fill": "reparte el ancho a partes iguales",
      "rule": "Rectangular (aprobado, propuesta B). Para alternar vistas dentro de una pantalla. Sin relleno de acento."
    },
    "toolbar-tabs": {
      "container": { "padding": 6, "gap": 4, "radius": "radius.md", "bg": "bg-sunken", "border": "line", "bare-variant": "sin fondo, para la barra de título" },
      "tab": { "min-width": 76, "padding-top": 6, "padding-bottom": 5, "radius": "radius.sm", "icon": 20, "gap": 4, "font": { "size": 11, "weight": 500 } },
      "fg": "ink-muted", "hover-bg": "bg-control", "active-bg": "bg-hover", "active-fg": "accent-strong",
      "rule": "Aprobado (propuesta E). Para las secciones de una ventana de preferencias. Sin subrayado."
    },
    "list-group": {
      "radius": "radius.lg", "bg": "bg-surface", "border": "line", "row-min-height": 44, "row-padding-x": 14,
      "separator": { "color": "line", "inset-left": 14 },
      "section-header": { "font": "caption", "uppercase": true, "color": "ink-muted", "padding": [10, 14, 4, 14] },
      "row-icon": { "size": 22, "radius": "radius.sm", "optional": true },
      "rule": "Por defecto: una sola ficha con encabezados de sección internos (C+), iconos opcionales."
    },
    "bento-tile": {
      "grid-columns": 4, "row-height": 92, "gap": "space.3", "radius": "radius.lg", "padding": 16,
      "tint": "color sys-* al 12–16 % sobre bg-surface", "active": "relleno sys-* o accent con texto blanco",
      "rule": "Alternativa a la lista. Por defecto tintado por categoría; puede ser dinámico (se rellena al activar) y con iconos grandes."
    },
    "app-icon": { "glyph": "#ffffff", "fills": ["sys-blue", "sys-cyan", "sys-purple", "sys-orange", "sys-green", "sys-red", "sys-gray"], "radius-rule": "paso de la escala más cercano a un tercio del lado: 22–28 → 8, 34–36 → 12, 52 → 16" },
    "window": {
      "radius": "radius.lg", "bg": "bg-window", "titlebar-height": "size.titlebar-h", "sidebar-width": "size.sidebar-w",
      "outer-border": "window-outer", "inner-line": "window-inner",
      "traffic-lights": { "size": 12, "radius": "radius.xs", "gap": 8, "colors": ["traffic-close", "traffic-min", "traffic-zoom"], "rule": "Mismos colores en todos los temas." }
    },
    "dialog": { "radius": "radius.lg", "bg": "bg-raised", "padding": 20, "scrim": "scrim", "outer-border": "window-outer", "inner-line": "window-inner" },
    "menu-popover": { "radius": "radius.md", "bg": "bg-raised", "item-height": 26, "item-radius": "radius.sm", "outer-border": "window-outer", "inner-line": "window-inner" },
    "progress": { "height": 6, "radius": "radius.pill", "track": "bg-control", "fill": "accent", "ring": { "size": 28, "stroke": 3.5 } },
    "badge": { "height": 20, "padding-x": 8, "radius": "radius.pill", "font": "caption" },
    "focus-ring": { "width": 2, "offset": 2, "color": "accent-strong", "rule": "Solo al navegar con teclado." }
  }
}
